SECRET_KEY=change-me
DEBUG=1
ALLOWED_HOSTS=127.0.0.1,localhost
# Add your LAN IP or any extra dev hosts (comma-separated), e.g. 192.168.1.37
EXTRA_ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
TIME_ZONE=America/Chicago

# Optional. If set, overrides the individual POSTGRES_* variables below.
DATABASE_URL=
POSTGRES_DB=putnam_trashmap
POSTGRES_USER=putnam
POSTGRES_PASSWORD=putnam
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_SSL_REQUIRE=0
CONN_MAX_AGE=60
WEB_PORT=8000
LOG_LEVEL=INFO
RUN_COLLECTSTATIC=1
GUNICORN_WORKERS=3
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=31536000

# Reserved for optional invite-code signup flow (not enabled in MVP).
INVITE_CODE=

# Production object storage for media uploads (Cloudflare R2 / S3-compatible).
USE_S3_MEDIA=0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=auto
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=

# Optional Redis URL for rate limiting cache (defaults to in-memory).
REDIS_URL=
