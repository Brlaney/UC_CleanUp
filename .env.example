SECRET_KEY=change-me
DEBUG=1
ALLOWED_HOSTS=127.0.0.1,localhost
# Add your LAN IP or any extra dev hosts (comma-separated), e.g. 192.168.1.37
EXTRA_ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
TIME_ZONE=America/Chicago

# Optional. If set, overrides the individual POSTGRES_* variables below.
DATABASE_URL=
POSTGRES_DB=putnam_trashmap
POSTGRES_USER=putnam
POSTGRES_PASSWORD=putnam
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_SSL_REQUIRE=0
CONN_MAX_AGE=60
WEB_PORT=8000
LOG_LEVEL=INFO
RUN_COLLECTSTATIC=1
GUNICORN_WORKERS=3
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=31536000

# Reserved for optional invite-code signup flow (not enabled in MVP).
INVITE_CODE=

# Production object storage for media uploads (Cloudflare R2 / S3-compatible).
# NOTE: settings.py reads the CF_* names below and maps them onto Django's
# AWS_* storage settings internally. Set these CF_* vars, not AWS_*.
USE_S3_MEDIA=0
CF_ACCESS_KEY_ID=
CF_SECRET_ACCESS_KEY=
CF_BUCKET_NAME=
CF_S3_ENDPOINT_URL=
CF_S3_CUSTOM_DOMAIN=

# Email (console backend in dev; set SMTP host/user/password for prod).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@uc-cleanup.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Recipients for the automated monthly chronic-site report/digest.
DISTRICT_REP_EMAIL=
COMMISSIONER_EMAIL=
DPW_DIRECTOR_EMAIL=

# Web Push (VAPID). Generate a keypair (see README) before enabling push.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_EMAIL=mailto:admin@uc-cleanup.com

# Optional Redis URL for rate limiting cache (defaults to in-memory).
REDIS_URL=
